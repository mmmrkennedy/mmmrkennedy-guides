# Cloudflare Pages headers
#
# Rules STACK. Every matching block applies, and a repeated header name is
# joined with a comma (developers.cloudflare.com/pages/configuration/headers/).
# A more specific rule does NOT override a general one. So each header name must
# appear in only one block that can match a given URL. Security headers live in
# the /* block at the bottom and nowhere else. Do not re-add them above.
#
# Only ONE splat (*) is allowed per path. /**/*.html is not a valid pattern.
#
# These do NOT apply to Pages Functions responses. If /api/trending is a
# Function, set its headers in the Function's Response instead.

# Homepage. CDN-Cache-Control is read by the edge, Cache-Control by browsers,
# so the edge serves 5 min from cache while browsers revalidate every visit.
#
# DO NOT "simplify" to `max-age=0, s-maxage=300`. Deployed to production
# 2026-08-07 and measured DYNAMIC on every request, TTFB unchanged. The docs
# disagree with themselves on whether max-age=0 is cacheable; the measurement
# on this zone is what counts.
/
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, max-age=300

# Guide/solver pages are served extensionless (Pages 308-redirects .html), so
# they are matched by name suffix. Not by path depth, since assets sit at the
# same depth (/games/IW/wyler_language_symbols/a.webp) and a depth rule would
# steal them from the image rules below. Every page ends in one of these four
# suffixes. Keep it that way when adding pages.
/games/*_guide
  Cache-Control: public, max-age=300, must-revalidate

/games/*_solver
  Cache-Control: public, max-age=300, must-revalidate

/games/*_solvers
  Cache-Control: public, max-age=300, must-revalidate

/games/*_table
  Cache-Control: public, max-age=300, must-revalidate

# CSS/JS are content-hashed by build_scripts/minify-assets.js as of 2026-07-29,
# so a given URL's bytes never change and 30 days is safe.
#
# Do NOT add a separate `immutable` rule for the hashed files alongside these.
# Rules stack, so /*.css plus /css/bundle.*.min.css would emit both values
# joined by a comma. Getting immutable would mean deleting these two rules and
# marking /css/* and /js/* immutable wholesale, which would freeze any future
# unhashed file for a year (/css/styles.css is still unhashed today).
/*.css
  Cache-Control: public, max-age=2592000, must-revalidate

/*.js
  Cache-Control: public, max-age=2592000, must-revalidate

# Images are not content-hashed, so a changed image keeps its URL. no-cache
# means "store, but revalidate before reuse", not "don't cache" (that is
# no-store). Browser sends a conditional request and gets a 304 when unchanged.
#
# Only works while the zone's Browser Cache TTL is "Respect Existing Headers"
# (dashboard, Caching > Configuration). A duration there overrides any shorter
# origin TTL, which is what served 4h-stale images until 2026-07-24.
/*.webp
  Cache-Control: public, no-cache

/*.jpg
  Cache-Control: public, no-cache

/*.png
  Cache-Control: public, no-cache

/*.gif
  Cache-Control: public, no-cache

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Security headers for everything. This is the only place they appear.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()