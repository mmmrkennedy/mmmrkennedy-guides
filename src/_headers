# Cloudflare Pages Headers Configuration
# This file provides caching and security headers for the website
#
# ONE PATH PER BLOCK. Pages does NOT let several path lines share a following
# block of headers — only the path directly above the headers gets them, and the
# rest are dropped with "No headers specified" (visible in the build log, and in
# `wrangler pages dev dist`). Repeat the block instead, however verbose it looks.

# Root path - force revalidation for main page
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Cache HTML files for shorter time to allow updates.
# In practice this matches nothing: Pages 308-redirects /foo.html to /foo, so
# pages are requested extensionless and are covered by the suffix rules below.
/**/*.html
  Cache-Control: public, max-age=300, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Guide and solver pages are served extensionless (/games/BO6/terminus/terminus_guide),
# so the rule above never matches them — without these they fall through to the
# Pages default of max-age=0 and revalidate on every visit. Matched by name suffix
# rather than by path depth: assets sit at the same depth
# (/games/IW/wyler_language_symbols/a.webp), and a depth-based rule would take
# them off the image rules below. Every page ends in one of these four suffixes;
# keep it that way when adding pages.
/games/*_guide
  Cache-Control: public, max-age=300, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/games/*_solver
  Cache-Control: public, max-age=300, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/games/*_solvers
  Cache-Control: public, max-age=300, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/games/*_table
  Cache-Control: public, max-age=300, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# CSS/JS are content-addressed as of 2026-07-29 — build_scripts/minify-assets.js
# puts a hash of the bytes in the filename (bundle.a94d3556.min.css), so a given
# URL's content never changes and 30 days of caching is safe. Before that, the
# version rode in a query string (?v=<build timestamp>) while the path stayed
# constant, and an edge entry poisoned during deploy propagation served
# month-old CSS under a brand-new ?v= for the full max-age below.
#
# Do NOT add a longer `immutable` rule for the hashed files alongside these.
# Pages does not let a more specific rule override a general one — per
# developers.cloudflare.com/pages/configuration/headers/, "if a header is applied
# twice in the _headers file, the values are joined with a comma separator", so
# /*.css plus /css/bundle.*.min.css would emit
# `public, max-age=2592000, must-revalidate, public, max-age=31536000, immutable`.
# Getting immutable would mean deleting these two rules and marking /css/* and
# /js/* immutable wholesale — which silently freezes any future *unhashed* file
# for a year (/css/styles.css is still unhashed today; the react-solvers dev page
# references it). Not worth trading that trap for one conditional request a month.
/*.css
  Cache-Control: public, max-age=2592000, must-revalidate

/*.js
  Cache-Control: public, max-age=2592000, must-revalidate

# Images: revalidate before every reuse. Filenames are NOT content-hashed, so a
# changed image keeps the same URL. `no-cache` means "store, but check with the
# origin before serving from cache" — the browser sends a conditional request
# (If-None-Match / If-Modified-Since) and Cloudflare answers 304 with no body
# when unchanged, or sends the new bytes immediately when the image changed.
# (`no-cache` does NOT mean "don't cache" — that would be `no-store`.)
#
# This only works while the zone's Browser Cache TTL is "Respect Existing
# Headers" (Cloudflare dashboard → Caching → Configuration). Set to a duration
# instead, it overrides any origin TTL shorter than itself, and these become
# `max-age=<that duration>` — which is what silently happened until 2026-07-24,
# when a 4-hour setting was serving 4h-stale images. CSS/JS/fonts were unaffected
# because their TTLs are longer than 4h.
/*.webp
  Cache-Control: public, no-cache

/*.jpg
  Cache-Control: public, no-cache

/*.png
  Cache-Control: public, no-cache

/*.gif
  Cache-Control: public, no-cache

# Cache fonts for 1 year
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Security headers for all files (fallback)
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()