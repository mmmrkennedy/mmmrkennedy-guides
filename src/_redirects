# Google's favicon fetcher probes the root path first, regardless of the
# <link rel="icon"> tag. The real file lives under /favicon/.
/favicon.ico   /favicon/favicon.ico   301

# Catch malformed nested URLs (e.g. /games/WW2/the_frozen_dawn/games/BO3/...)
# These resolved to index.html with the wrong URL; redirect to root.
