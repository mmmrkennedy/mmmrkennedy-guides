<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- SEO Meta Tags -->
    {%- if mapName and solverTitle %}
        {%- set pageTitle = mapName + ' ' + solverTitle + ' | ' + titleSuffix %}
    {%- elif mapName %}
        {%- set pageTitle = mapName + ' Easter Egg Guide | ' + titleSuffix %}
    {%- else %}
        {%- set pageTitle = title %}
    {%- endif %}
    <title>{{ pageTitle }}</title>

    {%- if mapName and solverTitle %}
        {%- set metaDescription = description or 'Interactive ' + solverTitle + ' for the ' + mapName + ' Easter Egg in ' + titleSuffix + '. Auto-solve this Call of Duty Zombies main quest step with a step-by-step walkthrough tool.' %}
    {%- elif mapName %}
        {%- set metaDescription = description or 'Complete ' + mapName + ' Easter Egg guide for ' + titleSuffix + '. Full main quest (main Easter Egg) walkthrough with step-by-step instructions, pictures, and videos, for solo and co-op.' %}
    {%- else %}
        {%- set metaDescription = description or 'Complete Call of Duty Zombies Easter Egg guide. Step-by-step main quest walkthrough with pictures, videos, and detailed instructions.' %}
    {%- endif %}
    {%- if aliases %}
        {%- set metaDescription = metaDescription + ' Also known as ' + (aliases | join(', ')) + '.' %}
    {%- endif %}
    <meta name="description" content="{{ metaDescription }}">
    {%- if mapName %}
        {%- set metaKeywords = mapName + ' Easter Egg, ' + mapName + ' Easter Egg guide, ' + mapName + ' main quest, ' + mapName + ' main Easter Egg, ' + mapName + ' walkthrough, ' + mapName + ' guide, ' + mapName + ' steps, ' + mapName + ' tutorial, ' + mapName + ' solo Easter Egg, ' + titleSuffix + ', Call of Duty Zombies, COD Zombies, Zombies Easter Egg guide, main quest walkthrough' %}
        <meta name="keywords" content="{{ metaKeywords }}">
    {%- endif %}
    <meta name="author" content="mmmrkennedy">
    {%- if unfinished or page.url in unfinishedPages %}
        <meta name="robots" content="noindex, nofollow">
    {%- else %}
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    {%- endif %}
    <link rel="canonical" href="https://mmmrkennedy.com{{ page.url | cleanUrl }}">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://mmmrkennedy.com{{ page.url | cleanUrl }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:image" content="{{ ogImage or 'https://mmmrkennedy.com/og_image.png' }}">
    <meta property="og:site_name" content="mmmrkennedy's Zombies Guides">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://mmmrkennedy.com{{ page.url | cleanUrl }}">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ metaDescription }}">
    <meta name="twitter:image" content="{{ ogImage or 'https://mmmrkennedy.com/og_image.png' }}">

    <!-- Stylesheets -->
    {%- if site.bundled %}
        <link rel="stylesheet" type="text/css" href="/css/bundle.min.css?v={{ site.buildVersion }}">
    {%- else %}
        <link rel="stylesheet" type="text/css" href="/css/styles.css?v={{ site.buildVersion }}">
    {%- endif %}
    {%- if useSolverCSS %}
        <link rel="stylesheet" type="text/css" href="/css/Solvers.css?v={{ site.buildVersion }}">
    {%- endif %}

    <!-- AdSense -->
    <meta name="google-adsense-account" content="ca-pub-2164582284838563">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2164582284838563" crossorigin="anonymous"></script>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico">
    <link rel="dns-prefetch" href="//ko-fi.com">
    <link rel="dns-prefetch" href="//www.youtube.com">
    <link rel="dns-prefetch" href="//discord.com">
    {%- if preloadImages %}
        {%- for imgSrc in preloadImages %}
        <link rel="preload" as="image" href="{{ imgSrc }}">
        {%- endfor %}
    {%- endif %}
    <!-- REACT_BUNDLE_MODULEPRELOAD -->

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "HowTo",
            "name": "{{ pageTitle }}",
            {%- if mapName %}
            "alternateName": [{% for alias in aliases %}"{{ alias }} Easter Egg Guide", {% endfor %}"{{ mapName }} Easter Egg Guide"],
            "keywords": "{{ metaKeywords }}",
            {%- endif %}
            "description": "{{ metaDescription }}",
            "url": "https://mmmrkennedy.com{{ page.url | cleanUrl }}",
            "image": "{{ ogImage or 'https://mmmrkennedy.com/og_image.png' }}",
            "author": {
                "@type": "Person",
                "name": "mmmrkennedy",
                "url": "https://mmmrkennedy.com"
            },
            "publisher": {
                "@type": "Organization",
                "name": "mmmrkennedy's Zombies Guides",
                "url": "https://mmmrkennedy.com"
            },
            "genre": "Gaming Guide",
            "about": {
                "@type": "VideoGame",
                "name": "Call of Duty Zombies"
            }
        }
    </script>

    {%- if breadcrumb %}
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Home",
                        "item": "https://mmmrkennedy.com/"
                    }
            {%- for crumb in breadcrumb -%}
        ,{
            "@type": "ListItem",
            "position": {{ loop.index + 1 }},
            "name": "{{ crumb.name }}",
            "item": "https://mmmrkennedy.com{{ crumb.url }}"
        }
        {%- endfor %}
        {%- if solverTitle %}
        ,{
            "@type": "ListItem",
            "position": {{ breadcrumb | length + 2 }},
            "name": "{{ mapName }}",
            "item": "https://mmmrkennedy.com{{ guideUrl | cleanUrl }}"
        }
        ,{
            "@type": "ListItem",
            "position": {{ breadcrumb | length + 3 }},
            "name": "{{ solverTitle }}",
            "item": "https://mmmrkennedy.com{{ page.url | cleanUrl }}"
        }
        {%- else %}
        ,{
            "@type": "ListItem",
            "position": {{ breadcrumb | length + 2 }},
            "name": "{{ mapName or pageTitle }}",
            "item": "https://mmmrkennedy.com{{ page.url | cleanUrl }}"
        }
        {%- endif %}
            ]
        }
        </script>
    {%- endif %}
</head>

<body{% if skipTOC %} data-skip-toc="true"{% endif %}{% if noFlags %} data-no-flags{% endif %}{% if statsPage %} data-stats-live{% endif %}>
<div class="top-buttons-background-box">
    <!-- Title at the top of the page -->
    <h1 class="title-text">{{ pageTitle }}</h1>
    {%- if not noLegend %}
    <button type="button" id="legendLauncher" class="btn legend-launcher"
            aria-haspopup="dialog" aria-expanded="false" aria-controls="legendOverlay"
            aria-label="How to read this guide">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
            <path d="M12 17h.01" />
        </svg>
    </button>
    {%- endif %}

    <!-- Mobile devices content -->
    <div id="mobile-content">
        <button type="button" class="btn btn--fixed top-left" onclick="navigateToIndex()" aria-label="Back">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-arrow-left-icon lucide-circle-arrow-left" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="m12 8-4 4 4 4" />
                <path d="M16 12H8" />
            </svg>
        </button>
        <button type="button" class="btn btn--fixed bottom-right" onclick="window.ScrollManager.scrollToTop()" aria-label="Back to Top">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-to-line-icon lucide-arrow-up-to-line" aria-hidden="true">
                <path d="M5 3h14" />
                <path d="m18 13-6-6-6 6" />
                <path d="M12 7v14" />
            </svg>
        </button>
    </div>

    <!-- Non-mobile devices content -->
    <div id="non-mobile-content">
        <button type="button" class="btn btn--fixed top-left" onclick="navigateToIndex()">Back</button>
        <button type="button" class="btn btn--fixed bottom-right" onclick="window.ScrollManager.scrollToTop()">Back to Top</button>
    </div>

    <div class="version-display">
        <div class="version-and-toggle">
            <button type="button" id="ad-toggle-btn" class="ad-toggle-btn" aria-pressed="true">Hide Ads</button>
            <span id="ad-mode-indicator" class="ad-mode-indicator"></span>
        </div>
    </div>
</div>

<div class="content-window{% if not statsPage %} prose{% endif %}">
    {%- if unfinished or page.url in unfinishedPages %}
        <div class="content-container">
            <h2>Sorry, this page is not ready yet!</h2>
            <p>Please check back later.</p>
        </div>
    {%- else %}
        {{ content | safe }}
        {%- if about %}
        <section class="about-map">
            <h2 class="about-map__title">About This Map</h2>
            <p class="about-map__text">{{ about }}</p>
        </section>
        {%- endif %}
    {%- endif %}

    <footer class="site-footer">
        {%- set updated = page.inputPath | lastmod %}
        {%- set updatedISO = page.inputPath | lastmodISO %}
        {%- set updatedRel = page.inputPath | lastmodRelative %}
        {%- set released = page.inputPath | released %}
        {%- set releasedISO = page.inputPath | releasedISO %}
        {%- set releasedRel = page.inputPath | releasedRelative %}
        {%- set edits = page.inputPath | editcount %}
        {%- set editorList = editors | formatEditors %}
        {#- An unfinished page shows the placeholder above instead of `content`,
            so it must not advertise the word count of a body nobody can read. #}
        {%- set words = null if (unfinished or noWordCount or page.url in unfinishedPages) else (content | wordcount) %}
        <p class="site-footer__meta">
            <span class="site-footer__copyright">&copy; {% year %} mmmrkennedy</span>
            {%- if editorList %}<span class="site-footer__sep" aria-hidden="true"></span><span class="site-footer__editors">Edited by {{ editorList }}</span>{% endif %}
            {%- if released %}<span class="site-footer__sep" aria-hidden="true"></span><time class="site-footer__released" datetime="{{ releasedISO }}" title="Released {{ releasedRel }}">Initial release {{ released }}</time>{% endif %}
            {%- if updated %}<span class="site-footer__sep" aria-hidden="true"></span><time class="site-footer__updated" datetime="{{ updatedISO }}" title="Last updated {{ updated }}">Updated {{ updatedRel }}</time>{% endif %}
            {%- if edits %}<span class="site-footer__sep" aria-hidden="true"></span><span class="site-footer__edits">{{ edits }} edit{{ "s" if edits != 1 }}</span>{% endif %}
            {%- if words %}<span class="site-footer__sep" aria-hidden="true"></span><span class="site-footer__words">{{ words | thousands }} words</span>{% endif %}
            {%- if not statsPage %}<span class="site-footer__sep" aria-hidden="true"></span><a class="site-footer__link" href="/stats">Site stats</a>{% endif %}
            <span class="site-footer__views"></span>
        </p>
    </footer>
</div>


<!-- Ko-fi -->
{% if showKofi %}
    <div class="kofi-container">
        <a href="https://ko-fi.com/X8X61TUY37" target="_blank" class="kofi-button"> <img src="/tips_symbol.png" alt="Ko-fi" class="kofi-img"> Tips </a>
    </div>
{% endif %}

{%- if site.bundled %}
<script src="/js/bundle.core.min.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/bundle.ads.min.js?v={{ site.buildVersion }}" async></script>
{%- else %}
<script src="/js/core/page-utils.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/navigation/scroll-manager.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/ui/legend.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/ui/lightbox.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/content/link-processor.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/content/quick-links.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/content/solver-button-processor.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/quick-links-utils.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/scripts.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/ui/view-counter.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/ui/relative-time.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/ui/line-flagger.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/ui/return-pill.js?v={{ site.buildVersion }}" defer></script>
{%- if statsPage %}
<script src="/js/ui/stats-live.js?v={{ site.buildVersion }}" defer></script>
<script src="/js/ui/table-sort.js?v={{ site.buildVersion }}" defer></script>
{%- endif %}
<!-- Ads load as an independent async island (ads.ts self-bootstraps) -->
<script src="/js/ui/ads.js?v={{ site.buildVersion }}" async></script>
{%- endif %}

{%- if useReactSolvers %}
    <!-- REACT_BUNDLE_PLACEHOLDER -->
{%- endif %}

<!-- Legend / "How to read this guide" overlay (launcher lives in the title bar) -->
{%- if not noLegend %}
<div class="legend-overlay" id="legendOverlay" role="dialog" aria-modal="true" aria-labelledby="legendTitle">
    <div class="legend-panel">
        <div class="legend-header">
            <h2 id="legendTitle" class="legend-title">How to read this guide</h2>
            <button type="button" id="legendClose" class="legend-close" aria-label="Close">&times;</button>
        </div>

        <p class="legend-intro">Links are colour-coded by where they take you:</p>
        <ul class="legend-list">
            <li class="legend-row">
                <a class="legend-swatch">Blue text</a>
                <span class="legend-desc"><strong>Image</strong> - opens in a viewer. Use &larr; / &rarr; to move between images; click outside or &times; to close.</span>
            </li>
            <li class="legend-row">
                <a class="legend-swatch link-to-page">Teal text</a>
                <span class="legend-desc"><strong>Internal</strong> - jumps to another spot within this page.</span>
            </li>
            <li class="legend-row">
                <a class="legend-swatch internal-link">Copper text</a>
                <span class="legend-desc"><strong>Page</strong> - navigates to another page on this site.</span>
            </li>
            <li class="legend-row">
                <a class="legend-swatch external-link">Green text</a>
                <span class="legend-desc"><strong>External</strong> - opens another website (YouTube, Reddit&hellip;) in a new tab.</span>
            </li>
            <li class="legend-row">
                <a class="legend-swatch solver-link">Violet text</a>
                <span class="legend-desc"><strong>Solver</strong> - opens an interactive tool.</span>
            </li>
            <li class="legend-row">
                <a class="legend-swatch" style="color:var(--color-danger-text)">⚑ Flag</a>
                <span class="legend-desc"><strong>Flag a line</strong> - hover any sentence or bullet and click the ⚑ at its end to report something that doesn’t make sense, is out of date, is wrong, or doesn’t work in-game.</span>
            </li>
        </ul>

        <p class="legend-tip">Tip: the <strong>Back to Top</strong> button jumps you to the start of any guide.</p>
    </div>
</div>
{%- endif %}

<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button class="close-lightbox" type="button" aria-label="Close"></button>
    <div class="lightbox-content">
        <div class="lightbox-caption"></div>
        <img id="lightbox-img" src="" alt="Enlarged image">
        <video id="lightbox-video" controls loop style="display: none; object-fit: contain;">
            Your browser does not support the video tag.
        </video>
        <audio id="lightbox-audio" controls preload="metadata" style="display: none;">
            Your browser does not support the audio tag.
        </audio>
        <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous image"></button>
        <button class="lightbox-nav lightbox-next" type="button" aria-label="Next image"></button>
    </div>
</div>
</body>
</html>
