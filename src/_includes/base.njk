<!-- Legend / "How to read this guide" overlay (launcher lives in the title bar) -->
{%- if not noLegend %}
<div class="legend-overlay" id="legendOverlay" role="dialog" aria-modal="true" aria-labelledby="legendTitle">
    <div class="legend-panel">
        <div class="legend-header">
            <h2 id="legendTitle" class="legend-title">How to read this guide</h2>
            <button type="button" id="legendClose" class="legend-close" aria-label="Close">&times;</button>
        </div>

        <p class="legend-intro">Links are colour-coded by where they take you:</p>
        <ul class="legend-list">
            <li class="legend-row">
                <a class="legend-swatch">Blue text</a>
                <span class="legend-desc"><strong>Image</strong> - opens in a viewer. Use &larr; / &rarr; to move between images; click outside or &times; to close.</span>
            </li>
            <li class="legend-row">
                <a class="legend-swatch link-to-page">Teal text</a>
                <span class="legend-desc"><strong>Internal</strong> - jumps to another spot within this page.</span>
            </li>
            <li class="legend-row">
                <a class="legend-swatch internal-link">Copper text</a>
                <span class="legend-desc"><strong>Page</strong> - navigates to another page on this site.</span>
            </li>
            <li class="legend-row">
                <a class="legend-swatch external-link">Green text</a>
                <span class="legend-desc"><strong>External</strong> - opens another website (YouTube, Reddit&hellip;) in a new tab.</span>
            </li>
            <li class="legend-row">
                <a class="legend-swatch solver-link">Violet text</a>
                <span class="legend-desc"><strong>Solver</strong> - opens an interactive tool.</span>
            </li>
            <li class="legend-row">
                <a class="legend-swatch" style="color:var(--color-danger-text)">⚑ Flag</a>
                <span class="legend-desc"><strong>Flag a line</strong> - hover any sentence or bullet and click the ⚑ at its end to report something that doesn’t make sense, is out of date, is wrong, or doesn’t work in-game.</span>
            </li>
        </ul>

        <p class="legend-tip">Tip: the <strong>Back to Top</strong> button jumps you to the start of any guide.</p>
    </div>
</div>
{%- endif %}

<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button class="close-lightbox" type="button" aria-label="Close"></button>
    <div class="lightbox-spinner" role="status" aria-label="Loading media" hidden></div>
    <div class="lightbox-content">
        <div class="lightbox-caption"></div>
        <img id="lightbox-img" src="" alt="Enlarged image">
        <video id="lightbox-video" controls loop style="display: none; object-fit: contain;">
            Your browser does not support the video tag.
        </video>
        <audio id="lightbox-audio" controls preload="metadata" style="display: none;">
