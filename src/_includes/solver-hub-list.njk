{#- Cards come from solver pages' front matter (build_scripts/eleventy/solver-index.cjs).
    The line is a <span>, not a <p>: line-flagger decorates `.content-container p`,
    and a flag button inside an anchor would navigate on click. -#}
<div class="content-container">
    <div class="solver-hub">
        {%- for s in collections.solverPages | solverSpokes(page.url) %}
        <a class="solver-hub__card" data-prefetchable href="{{ s.url | cleanUrl }}">
            <h2 class="solver-hub__name">{{ s.data.solverTitle }}</h2>
            <span class="solver-hub__line">{{ s.data.hubLine or s.data.description }}</span>
        </a>
        {%- endfor %}
    </div>
</div>
