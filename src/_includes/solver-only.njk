---
layout: base.njk
useSolverCSS: true
useReactSolvers: true
# base.njk preloads the bundle and lets Solvers.css block paint.
# guide-with-solver.njk deliberately does not set this.
solverIsPrimary: true
skipTOC: true
---
<div class="solver-only-page">
{{ content | safe }}
{#- Always shown, since the return pill only appears for click-throughs from the
    guide. Outside .content-container and not a <p>, so line-flagger.ts ignores it.
    Hidden while the guide is an unfinished stub. -#}
{%- set guideClean = guideUrl | cleanUrl %}
{%- if mapName and guideUrl and guideClean not in unfinishedPages %}
{#- Name first: "Full The Frozen Dawn Map Guide" doesn't read. -#}
{%- set guideLabel = mapName + ' Full Map Guide' %}
<nav class="solver-guide-link" aria-label="Related guide">
    <a class="solver-guide-link__anchor internal-link" href="{{ guideClean }}">{{ guideLabel }}</a>
</nav>
{%- endif %}
</div>
