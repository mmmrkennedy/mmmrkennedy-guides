{
    "name": "zombies-guides",
    "version": "1.0.0",
    "description": "Zombies Guides website with automated build system",
    "type": "module",
    "scripts": {
        "// build": "Production builds — bundled, minified, versioned",
        "build": "bun run build:scripts && bun run build:react && cross-env BUNDLE=true IMAGES_FROM_R2=true bun run build:eleventy && cross-env BUNDLE=true node build_scripts/minify-assets.js && node build_scripts/minify-html.js && bun run build:sitemap",
        "build:full": "bun run clean && bun run build",
        "// dev": "Development servers — unbundled, hot reload",
        "dev": "eleventy --serve",
        "dev:watch": "concurrently --names \"tsc,vite,11ty\" --prefix-colors \"yellow,cyan,green\" \"tsc -p tsconfig.scripts.json --watch\" \"vite build --watch\" \"eleventy --serve\"",
        "dev:react": "vite",
        "// steps": "Individual build steps",
        "build:scripts": "tsc -p tsconfig.scripts.json",
        "build:react": "vite build",
        "build:eleventy": "eleventy --incremental",
        "build:sitemap": "node build_scripts/generate-sitemap.cjs",
        "// verify": "Post-deploy check — run against the live site after publishing",
        "verify:deploy": "node build_scripts/verify-deploy.mjs",
        "minify": "node build_scripts/minify-assets.js",
        "clean": "rimraf dist",
        "// images": "Image conversion utilities",
        "convert:images": "python python_utilities/image_converter.py",
        "// lint": "Linting and formatting",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:css": "stylelint \"**/*.css\"",
        "lint:css:fix": "stylelint \"**/*.css\" --fix",
        "css:check": "node build_scripts/css-usage-analyzer.js",
        "// git": "Local git hooks (re-applied on install)",
        "prepare": "git config core.hooksPath .githooks"
    },
    "keywords": [
        "zombies",
        "guides",
        "gaming",
        "static-site",
        "build-tools"
    ],
    "author": "mmmrkennedy",
    "license": "MIT",
    "dependencies": {
        "jsdom": "^22.1.0",
        "preact": "^10.29.1",
        "sitemap": "^8.0.0"
    },
    "engines": {
        "node": ">=14.0.0"
    },
    "homepage": "https://mmmrkennedy.com",
    "devDependencies": {
        "@11ty/eleventy": "^3.1.2",
        "@eslint/js": "^9.38.0",
        "@preact/preset-vite": "^2.10.5",
        "clean-css-cli": "^5.6.3",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "eslint": "^9.38.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.0",
        "globals": "^16.4.0",
        "html-minifier-terser": "^7.2.0",
        "playwright": "^1.61.1",
        "rimraf": "^6.1.2",
        "stylelint": "^16.25.0",
        "stylelint-config-standard": "^39.0.1",
        "terser": "^5.46.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.54.0",
        "vite": "^7.1.11"
    }
}
