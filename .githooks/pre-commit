#!/bin/sh
# Keep page dates and edit counts current in the same commit as the page change.
# Only runs when .html files are staged (added/changed/renamed/deleted).

if git diff --cached --name-only --diff-filter=ACMRD -- "*.html" | grep -q .; then
    if ! node build_scripts/update-page-dates.cjs; then
        echo "pre-commit: update-page-dates.cjs failed; aborting commit." >&2
        echo "  (commit with --no-verify to skip this hook if needed)" >&2
        exit 1
    fi
    git add build_scripts/lastmod-cache.json build_scripts/editcount-cache.json build_scripts/release-dates.json
fi
